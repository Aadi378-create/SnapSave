# Production-safe defaults. Edit existing .env files rather than overwriting them.
APP_ENV=production
ENABLE_DEV_AUTH=false
ENABLE_LIVE_RESEARCH=false
AUTO_RESEARCH_NEW_ORDERS=false
# For staff-assisted browser planning, use core.order_research:prepare_research.
# Enable both research flags above and the admin AI switch to start new lists automatically.
RESEARCH_PROVIDER=core.catalog_research:research_catalog
FIREBASE_PROJECT_ID=snapsave-501c7
# Relative to this backend folder, or supply an absolute path.
FIREBASE_CREDENTIALS=admin/firebase-service-account.json
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Add the deployed API hostname here (no scheme or path); never use '*'.
ALLOWED_HOSTS=localhost,127.0.0.1
# Omit DATABASE_URL to use this backend folder's snapsave.db.
# DATABASE_URL=sqlite:///C:/path/to/snapsave.db
# Supply a merchant UPI ID before accepting orders.
UPI_ID=
UPI_PAYEE_NAME=SnapSave
STORE_SERVICEABILITY={}

# Optional server-owned retailer URL lists; {query} is URL-encoded at runtime.
# RESEARCH_CATALOG_SOURCES={"bigbasket":["https://www.bigbasket.com/pc/bakery-cakes-dairy/dairy/milk/"]}
# Optional browser-assisted evidence file. Captures expire after 15 minutes.
# RESEARCH_BROWSER_CAPTURE_FILE=C:/private/research/captures.json
